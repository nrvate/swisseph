+/* a refusal: ERR, k outputs 0, a message (containing word if not NULL) */
+static int refused(int32 r, const double *v, int k, const char *serr, const char *word)
+{
+  return r == ERR && all0(v, k) && serr[0] != '\0' && (word == NULL || strstr(serr, word) != NULL);
+}
