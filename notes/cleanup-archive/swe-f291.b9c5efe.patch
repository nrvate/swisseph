+}
+
+/* a context on the files, its observer at s: 0 none, 1 Zurich, 2 far */
+static swe_ctx *open_ctx(int s)
+{
+  swe_ctx *c = swe_ctx_new();
+  if (c == NULL)
+    return NULL;
+  swe_set_ephe_path_r(c, EPH);
+  swe_set_jpl_file_r(c, "de200.eph");
+  if (s == 1)
+    swe_set_topo_r(c, ZUR[0], ZUR[1], ZUR[2]);
+  else if (s == 2)
+    swe_set_topo_r(c, FAR[0], FAR[1], FAR[2]);
+  return c;
+}
