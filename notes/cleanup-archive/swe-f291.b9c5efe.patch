+/* Upstream bugs 292, 293: a number that is no body seen from the Earth --
+ * the Earth itself, SE_ECL_NUT, any other negative number -- refused by
+ * the functions that need the body's direction from the observer; with a
+ * star (do_fixstar) the number is not read. what: what the Earth has not,
+ * for the message. */
+static AS_BOOL no_body_seen(int32 ipl, AS_BOOL do_fixstar, const char *what, char *serr)
+{
+  if (do_fixstar)
+    return FALSE;
+  if (ipl == SE_EARTH) {
+    if (serr != NULL)
+      snprintf(serr, AS_MAXCH, "the Earth has no %s: it is the observer's own body", what);
+    return TRUE;
+  }
+  if (ipl < SE_SUN) {
+    if (serr != NULL)
+      snprintf(serr, AS_MAXCH, "illegal planet number %d.", ipl);
+    return TRUE;
+  }
+  return FALSE;
+}
