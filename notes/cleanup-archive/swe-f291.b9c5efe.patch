+/* (c) the default context, unset and then at the far site, published */
+static int check_c(int s)
+{
+  struct obs o0, o1, of;
+  swe_ctx *f;
+  int k, nmov = 0;
+  char what[256];
+  if (s == 0)
+    swe_set_ephe_path(EPH);
+  else
+    swe_set_topo(FAR[0], FAR[1], FAR[2]);
+  if ((f = open_ctx(s)) == NULL)
+    return -1;
+  observe(NULL, &o0);
+  observe(f, &of);
+  for (k = 0; k < NF; k++) {
+    char serr[256];
+    call(NULL, k, serr);
+    observe(NULL, &o1);
+    if (!obs_same(&o1, &of))
+      nmov++;
+  }
+  swe_ctx_free(f);
+  snprintf(what, sizeof what, "(c) the default context %s: %d of %d calls leave it off a fresh"
+           " context's", s == 0 ? "unset" : "at 70 W 30 S", nmov, NF);
+  check(obs_same(&o0, &of) && nmov == 0 && (s == 0) == (o1.r[0] < 0), what);
+  if (s == 0)
+    return 0;
+  /* a context made now inherits the published site, not the calls' */
+  if ((f = swe_ctx_new()) == NULL)
+    return -1;
+  observe(f, &o1);
+  swe_ctx_free(f);
+  check(obs_same(&o1, &of), "(c) a context made after them: not the published observer's");
+  printf("  (c) the default context's observer after the calls as a fresh context's: 3"
+         " checks\n");
+  return 0;
+}
