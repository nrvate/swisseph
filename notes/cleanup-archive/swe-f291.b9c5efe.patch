+static const int32 EPHS[3] = { SEFLG_SWIEPH, SEFLG_MOSEPH, SEFLG_JPLEPH };
+
+/* the refusals of body ipl in the functions that need its direction:
+ * which of NR answer; word, the message's */
+#define NR 7
+static const char *RNAMES[NR] = {
+  "swe_rise_trans()", "swe_rise_trans_true_hor()", "swe_pheno()", "swe_pheno_ut()",
+  "swe_lun_occult_when_glob()", "swe_lun_occult_when_loc()", "swe_lun_occult_where()",
+};
+
+/* f(arg) in a child process, which a search without end cannot hold
+ * past secs: 1 if it returned nonzero */
+static int in_child(int (*f)(void *), void *arg, int secs)
+{
+  pid_t pid;
+  int st;
+  fflush(stdout);
+  if ((pid = fork()) < 0)
+    return 0;
+  if (pid == 0) {
+    alarm(secs);
+    _exit(f(arg) ? 0 : 1);
+  }
+  if (waitpid(pid, &st, 0) != pid)
+    return 0;
+  return WIFEXITED(st) && WEXITSTATUS(st) == 0;
+}
