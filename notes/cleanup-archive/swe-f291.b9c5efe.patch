+  case 6: return CALL(swe_sol_eclipse_where, 2451401.9375, SEFLG_SWIEPH, geo, attr, serr);
+  case 7: return CALL(swe_sol_eclipse_when_glob, T, SEFLG_SWIEPH, 0, tret, 0, serr);
+  case 8: return CALL(swe_lun_occult_when_loc, T, 0, star, SEFLG_SWIEPH, geo, tret, attr, 0, serr);
+  case 9: return CALL(swe_lun_occult_where, T, 0, star, SEFLG_SWIEPH, geo, attr, serr);
+  case 10: return CALL(swe_lun_occult_when_glob, T, 0, star, SEFLG_SWIEPH, 0, tret, 0, serr);
+  case 11: return CALL(swe_lun_eclipse_how, T, SEFLG_SWIEPH, geo, attr, serr);
+  case 12: return CALL(swe_lun_eclipse_when_loc, T, SEFLG_SWIEPH, geo, tret, attr, 0, serr);
+  case 13: return CALL(swe_lun_eclipse_when, T, SEFLG_SWIEPH, 0, tret, 0, serr);
