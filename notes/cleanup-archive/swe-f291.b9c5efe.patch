+  case 15: return CALL(swe_gauquelin_sector, T, SE_MOON, NULL, SEFLG_SWIEPH, 4, geo, 0, 0, dret, serr);
+  case 16: return CALL(swe_gauquelin_sector, T, SE_MOON, NULL, SEFLG_SWIEPH | SEFLG_TOPOCTR, 0, geo, 0, 0, dret, serr);
+  case 17: return CALL(swe_vis_limit_mag, T + 0.75, geo, datm, dobs, obj, SEFLG_SWIEPH, dret, serr);
+  case 18: return CALL(swe_heliacal_pheno_ut, T + 0.75, geo, datm, dobs, obj, 1, SEFLG_SWIEPH, dret, serr);
+  case 19: return CALL(swe_heliacal_ut, T, geo, datm, dobs, obj, 1, SEFLG_SWIEPH, dret, serr);
+  case 20: return CALL(swe_topo_arcus_visionis, T, geo, datm, dobs, SEFLG_SWIEPH, -4, 100, 10, 90, 0, -10, dret, serr);
+  case 21: return CALL(swe_heliacal_angle, T, geo, datm, dobs, SEFLG_SWIEPH, -4, 100, 90, 0, -10, dret, serr);
