+    char serr[256];
+    body_refusals(c, NB[i], NULL, nans);
+    for (k = 0; k < NR; k++)
+      tot[k] += nans[k];
+    for (m = 0; m < 6; m++) {
+      int e;
+      for (e = 0; e < 3; e++) {
+        memcpy(geo, ZUR, sizeof ZUR);
+        fill7(v, 1);
+        serr[0] = '\0';
+        ng[m] += !refused(swe_gauquelin_sector_r(c, T, NB[i], NULL, EPHS[e], m, geo, 0, 0, v,
+                                                 serr), v, 1, serr, NULL);
+      }
+    }
+    for (k = 0; k < 2; k++) {
+      struct hc_arg a;
+      a.ut = k;
+      a.ipl = NB[i];
+      nh[k] += !in_child(hc_refused, &a, 20);
+    }
+    fill7(x, 6);
+    serr[0] = '\0';
+    np[0] += !refused(swe_calc_pctr_r(c, te, NB[i], SE_SUN, SEFLG_SWIEPH, x, serr), x, 6, serr,
+                      NULL);
+    fill7(x, 6);
+    serr[0] = '\0';
+    np[1] += !refused(swe_calc_pctr_r(c, te, SE_MARS, NB[i], SEFLG_SWIEPH, x, serr), x, 6,
+                      serr, NULL);
+  }
+  for (k = 0; k < NR; k++) {
+    snprintf(what, sizeof what, "(e) no body in %s: %d calls answer or keep an output",
+             RNAMES[k], tot[k]);
+    check(tot[k] == 0, what);
+  }
+  for (m = 0; m < 6; m++) {
+    snprintf(what, sizeof what, "(e) no body in swe_gauquelin_sector() method %d: %d of 12"
+             " answer", m, ng[m]);
+    check(ng[m] == 0, what);
+  }
+  for (k = 0; k < 2; k++) {
+    snprintf(what, sizeof what, "(e) no body in swe_helio_cross%s(): %d of 4 answer or do not"
+             " end", k ? "_ut" : "", nh[k]);
+    check(nh[k] == 0, what);
+    snprintf(what, sizeof what, "(e) no body as swe_calc_pctr()'s %s: %d of 4 answer",
+             k ? "centre" : "body", np[k]);
+    check(np[k] == 0, what);
+  }
+  k = star_as_number(c, SE_ECL_NUT, 0, 0);
+  snprintf(what, sizeof what, "(e) Regulus with ipl -1 in swe_rise_trans(): %d of 2 off", k);
+  check(k == 0, what);
+  k = star_as_number(c, SE_ECL_NUT, 1, 0);
+  snprintf(what, sizeof what, "(e) Regulus with ipl -1 in swe_gauquelin_sector(): %d of 2 off",
+           k);
+  check(k == 0, what);
+  k = star_as_number(c, SE_ECL_NUT, 0, 1);
+  snprintf(what, sizeof what, "(e) Regulus with ipl -1 in the occultations: %d of 2 off", k);
+  check(k == 0, what);
+  {
+    double v[40], geo[3], s;
+    char serr[256];
+    int nref = 0;
+    memcpy(geo, ZUR, sizeof ZUR);
+    nref += swe_lun_occult_when_glob_r(c, T, SE_SUN, NULL, SEFLG_SWIEPH, 0, v, 0, serr) <= 0;
+    nref += swe_lun_occult_when_loc_r(c, T, SE_SUN, NULL, SEFLG_SWIEPH, geo, v, v + 10, 0,
+                                      serr) <= 0;
+    nref += swe_rise_trans_r(c, T, SE_CUPIDO, NULL, SEFLG_SWIEPH, SE_CALC_RISE, geo, 0, 0, v,
+                             serr) < 0;
+    nref += swe_gauquelin_sector_r(c, T, SE_CUPIDO, NULL, SEFLG_SWIEPH, 4, geo, 0, 0, &s, serr)
+            < 0;
+    snprintf(what, sizeof what, "(e) the Sun in the occultations, Cupido in rise and the"
+             " sector: %d of 4 refused", nref);
+    check(nref == 0, what);
+  }
+  swe_ctx_free(c);
+  printf("  (e) the numbers that are no body refused, a star with one not: %d checks\n",
+         n - n0);
+  return 0;
+}
+
+int main(int argc, char **argv)
+{
+  int r;
+  if (argc != 2) {
+    fprintf(stderr, "usage: sitebody EPHEDIR\n");
+    return 2;
+  }
+  EPH = argv[1];
+  printf("G180: the geopos functions give the caller's observer back, the body functions"
+         " refuse the Earth and no body\n");
+  /* the default context unset first, and the explicit contexts made
+   * before it publishes an observer, which they would inherit */
+  r = check_c(0);
+  if (r == 0)
+    r = check_a();
+  if (r == 0)
+    r = check_b();
+  if (r == 0)
+    r = check_d();
+  if (r == 0)
+    r = check_e();
+  if (r == 0)
+    r = check_c(2);
+  if (r < 0) {
+    printf("G180 FAIL: ERROR\n");
+    return 1;
+  }
+  if (bad) {
+    printf("G180 FAIL: %d of %d\n", bad, n);
+    return 1;
+  }
+  printf("  %d checks within their limits\nG180 PASS\n", n);
+  return 0;
+}
