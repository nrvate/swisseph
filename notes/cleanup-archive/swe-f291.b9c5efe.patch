+static void body_refusals(swe_ctx *c, int32 ipl, const char *word, int *nans)
+{
+  static const int32 RSMI[6] = {
+    SE_CALC_RISE, SE_CALC_SET, SE_CALC_MTRANSIT, SE_CALC_ITRANSIT,
+    SE_CALC_RISE | SE_BIT_HINDU_RISING, SE_CALC_RISE | SE_BIT_FORCE_SLOW_METHOD,
+  };
+  int e, k;
+  memset(nans, 0, NR * sizeof *nans);
+  for (e = 0; e < 3; e++) {
+    int32 fl = EPHS[e], r;
+    double v[40], geo[20], te = T + swe_deltat_ex_r(c, T, fl, NULL);
+    char serr[256];
+    for (k = 0; k < 6; k++) {
+      memcpy(geo, ZUR, sizeof ZUR);
+      fill7(v, 1);
+      serr[0] = '\0';
+      r = swe_rise_trans_r(c, T, ipl, NULL, fl, RSMI[k], geo, 0, 0, v, serr);
+      nans[0] += !refused(r, v, 1, serr, word);
+    }
+    fill7(v, 1);
+    serr[0] = '\0';
+    r = swe_rise_trans_true_hor_r(c, T, ipl, NULL, fl, SE_CALC_RISE, geo, 0, 0, 2, v, serr);
+    nans[1] += !refused(r, v, 1, serr, word);
+    for (k = 0; k < 2; k++) {
+      int32 ft = k ? SEFLG_TOPOCTR : 0;
+      fill7(v, 20);
+      serr[0] = '\0';
+      r = swe_pheno_r(c, te, ipl, fl | ft, v, serr);
+      nans[2] += !refused(r, v, 20, serr, word);
+      fill7(v, 20);
+      serr[0] = '\0';
+      r = swe_pheno_ut_r(c, T, ipl, fl | ft, v, serr);
+      nans[3] += !refused(r, v, 20, serr, word);
+    }
+    for (k = 0; k < 3; k++) {
+      struct occ_arg a;
+      a.c = c;
+      a.ipl = ipl;
+      a.fl = fl;
+      a.which = k;
+      a.word = word;
+      nans[4 + k] += !in_child(occ_refused, &a, 10);
+    }
+  }
+}
