+/* the topocentric Moon, Mars and Spica with speeds at 1950 and J2000 on
+ * the Swiss files and Moshier: what a caller's observer gives */
+#define NOB 12
+struct obs {
+  int32 r[NOB];
+  double x[NOB][6];
+  char serr[NOB][64];
+};
+
+static void observe(swe_ctx *c, struct obs *o)
+{
+  static const int32 EPHF[2] = { SEFLG_SWIEPH, SEFLG_MOSEPH };
+  static const double TO[2] = { T, 2451545.0 };
+  int e, i, b, k = 0;
+  memset(o, 0, sizeof *o);
+  for (e = 0; e < 2; e++)
+    for (i = 0; i < 2; i++)
+      for (b = 0; b < 3; b++, k++) {
+        int32 fl = EPHF[e] | SEFLG_TOPOCTR | SEFLG_SPEED;
+        char serr[256] = "", star[64] = "Spica";
+        double te = TO[i] + (c != NULL ? swe_deltat_ex_r(c, TO[i], EPHF[e], NULL)
+                                       : swe_deltat_ex(TO[i], EPHF[e], NULL));
+        if (b == 2)
+          o->r[k] = CALL(swe_fixstar, star, te, fl, o->x[k], serr);
+        else
+          o->r[k] = CALL(swe_calc, te, b == 0 ? SE_MOON : SE_MARS, fl, o->x[k], serr);
+        if (o->r[k] < 0)
+          memset(o->x[k], 0, sizeof o->x[k]);
+        else
+          serr[0] = '\0';
+        {
+          size_t len = strlen(serr);	/* the message's start; o is zeroed */
+          if (len >= sizeof o->serr[k])
+            len = sizeof o->serr[k] - 1;
+          memcpy(o->serr[k], serr, len);
+        }
+      }
+}
+
+static int obs_same(const struct obs *a, const struct obs *b)
+{
+  return memcmp(a, b, sizeof *a) == 0;
+}
+
+/* (a) each call on an explicit context whose observer is unset and one
+ * whose observer is far: afterwards as before and as a fresh context's */
+static int check_a(void)
+{
+  int k, s;
+  char what[256];
+  for (k = 0; k < NF; k++) {
+    int ok = 1;
+    char how[128] = "";
+    for (s = 0; s < 3; s += 2) {
+      struct obs o0, o1, of;
+      char serr[256];
+      swe_ctx *c = open_ctx(s), *f = open_ctx(s);
+      if (c == NULL || f == NULL)
+        return -1;
+      observe(c, &o0);
+      call(c, k, serr);
+      observe(c, &o1);
+      observe(f, &of);
+      if (!obs_same(&o0, &of) || !obs_same(&o1, &of) || (s == 0) != (o1.r[0] < 0)) {
+        ok = 0;
+        snprintf(how + strlen(how), sizeof how - strlen(how), " %s: %s",
+                 s == 0 ? "unset" : "at 70 W 30 S",
+                 o1.r[0] >= 0 && s == 0 ? "answered" : "moved");
+        if (o1.r[0] >= 0 && of.r[0] >= 0)
+          snprintf(how + strlen(how), sizeof how - strlen(how), " (Moon %.4f for %.4f)",
+                   o1.x[0][0], of.x[0][0]);
+      }
+      swe_ctx_free(c);
+      swe_ctx_free(f);
+    }
+    snprintf(what, sizeof what, "(a) after %s the caller's observer is not its own:%s", NAMES[k],
+             how);
+    check(ok, what);
+  }
+  printf("  (a) after each of the %d calls the caller's observer as a fresh context's: %d"
+         " checks\n", NF, NF);
+  return 0;
+}
+
+static unsigned long long fnv(const void *p, size_t len, unsigned long long h)
+{
+  const unsigned char *b = p;
+  while (len--) {
+    h ^= *b++;
+    h *= 1099511628211ULL;
+  }
+  return h;
+}
+
+/* (b) each call's own answers the same whatever the caller's observer,
+ * called twice on one context */
+static int check_b(void)
+{
+  int k, s, rep;
+  char what[256];
+  for (k = 0; k < NF; k++) {
+    unsigned long long h[3];
+    for (s = 0; s < 3; s++) {
+      swe_ctx *c = open_ctx(s);
+      if (c == NULL)
+        return -1;
+      h[s] = 1469598103934665603ULL;
+      for (rep = 0; rep < 2; rep++) {
+        char serr[256];
+        int32 r;
+        memset(OUT, 0, sizeof OUT);
+        memset(serr, 0, sizeof serr);
+        r = call(c, k, serr);
+        h[s] = fnv(&r, sizeof r, h[s]);
+        h[s] = fnv(OUT, sizeof OUT, h[s]);
+        h[s] = fnv(serr, sizeof serr, h[s]);
+      }
+      swe_ctx_free(c);
+    }
+    snprintf(what, sizeof what, "(b) %s answers by the caller's observer", NAMES[k]);
+    check(h[0] == h[1] && h[1] == h[2], what);
+  }
+  printf("  (b) each call's answers the same whatever the caller's observer: %d checks\n", NF);
+  return 0;
+}
