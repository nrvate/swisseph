+/* outputs filled with 7, then: all 0 */
+static void fill7(double *v, int k)
+{
+  while (k-- > 0)
+    v[k] = 7;
+}
+
+static int all0(const double *v, int k)
+{
+  while (k-- > 0)
+    if (v[k] != 0)
+      return 0;
+  return 1;
+}
