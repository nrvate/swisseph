+    return refused(swe_lun_occult_when_glob_r(a->c, T, a->ipl, NULL, a->fl, 0, v, 0, serr),
+                   v, 10, serr, a->word);
+  if (a->which == 1)
+    return refused(swe_lun_occult_when_loc_r(a->c, T, a->ipl, NULL, a->fl, geo, v, v + 10, 0,
+                                             serr), v, 30, serr, a->word);
+  fill7(geo, 2);
+  r = swe_lun_occult_where_r(a->c, T, a->ipl, NULL, a->fl, geo, v, serr);
+  return refused(r, v, 20, serr, a->word) && all0(geo, 2);
+}
