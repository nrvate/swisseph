+/* Upstream bugs 301, 302: a read of the Earth at a light-time instant,
+ * made with ctx->moshmoon_used FALSE, took Moshier's Moon (the Moon file
+ * does not hold that instant) where the Earth at teval is the files' own
+ * (made with the file's Moon): the read is past the span of the Moon that
+ * answered at teval, for vel_at_lt_fwd() to replace */
+static AS_BOOL lt_earth_mixed(swe_ctx *ctx, double teval)
+{
+  const struct plan_data *pedp = &ctx->pldat[SEI_EARTH];
+  return ctx->moshmoon_used && pedp->iephe == SEFLG_SWIEPH && pedp->teval == teval
+         && ctx->moshmoon_earth_t != teval;
+}
